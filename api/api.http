@api_HostAddress = http://localhost:5016

### Get all tires
GET {{api_HostAddress}}/tires
Accept: application/json

### Get a single tire by id
GET {{api_HostAddress}}/tires/1
Accept: application/json

### Create a tire with an image link (Insomnia: Body > JSON)
POST {{api_HostAddress}}/tires
Content-Type: application/json

{
  "brand": "Michelin",
  "type": "AllSeason",
  "rimDiameter": 17,
  "price": 129.99,
  "imageUrl": "https://example.com/tire.jpg"
}

### Update a tire with JSON, keeping its existing image
PUT {{api_HostAddress}}/tires/1
Content-Type: application/json

{
  "brand": "Continental",
  "type": "Winter",
  "rimDiameter": 18,
  "price": 159.50
}

### Create a tire with an uploaded file (place a JPEG at api/tire.jpg before sending)
POST {{api_HostAddress}}/tires
Content-Type: multipart/form-data; boundary=tire-boundary

--tire-boundary
Content-Disposition: form-data; name="brand"

Michelin
--tire-boundary
Content-Disposition: form-data; name="type"

AllSeason
--tire-boundary
Content-Disposition: form-data; name="rimDiameter"

17
--tire-boundary
Content-Disposition: form-data; name="price"

129.99
--tire-boundary
Content-Disposition: form-data; name="image"; filename="tire.jpg"
Content-Type: image/jpeg

< ./tire.jpg
--tire-boundary--

### Update a tire, keeping its existing image
PUT {{api_HostAddress}}/tires/1
Content-Type: multipart/form-data; boundary=tire-boundary

--tire-boundary
Content-Disposition: form-data; name="brand"

Continental
--tire-boundary
Content-Disposition: form-data; name="type"

Winter
--tire-boundary
Content-Disposition: form-data; name="rimDiameter"

18
--tire-boundary
Content-Disposition: form-data; name="price"

159.50
--tire-boundary--
### Delete a tire
DELETE {{api_HostAddress}}/tires/1
