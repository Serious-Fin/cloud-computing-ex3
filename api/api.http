@api_HostAddress = http://localhost:5016

### Get all tires
GET {{api_HostAddress}}/tires
Accept: application/json

### Get a single tire by id
GET {{api_HostAddress}}/tires/1
Accept: application/json

### Create a tire
POST {{api_HostAddress}}/tires
Content-Type: application/json

{
  "brand": "Michelin",
  "type": "AllSeason",
  "rimDiameter": 17,
  "price": 129.99,
  "imageUrl": "https://example.com/michelin.png"
}

### Update a tire
PUT {{api_HostAddress}}/tires/1
Content-Type: application/json

{
  "brand": "Continental",
  "type": "Winter",
  "rimDiameter": 18,
  "price": 159.50,
  "imageUrl": "https://example.com/continental.png"
}

### Delete a tire
DELETE {{api_HostAddress}}/tires/1
